{
  "name": "@open-components/core",
  "version": "0.2.0",
  "description": "Headless component logic and shared CVA variant definitions for OpenComponents.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./alert": {
      "types": "./dist/alert/index.d.ts",
      "import": "./dist/alert/index.js"
    },
    "./badge": {
      "types": "./dist/badge/index.d.ts",
      "import": "./dist/badge/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./card": {
      "types": "./dist/card/index.d.ts",
      "import": "./dist/card/index.js"
    },
    "./code-block": {
      "types": "./dist/code-block/index.d.ts",
      "import": "./dist/code-block/index.js"
    },
    "./collapsible": {
      "types": "./dist/collapsible/index.d.ts",
      "import": "./dist/collapsible/index.js"
    },
    "./dropdown-menu": {
      "types": "./dist/dropdown-menu/index.d.ts",
      "import": "./dist/dropdown-menu/index.js"
    },
    "./dropdown-menu/behavior": {
      "types": "./dist/dropdown-menu/behavior.d.ts",
      "import": "./dist/dropdown-menu/behavior.js"
    },
    "./icon-button": {
      "types": "./dist/icon-button/index.d.ts",
      "import": "./dist/icon-button/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js"
    },
    "./kbd": {
      "types": "./dist/kbd/index.d.ts",
      "import": "./dist/kbd/index.js"
    },
    "./label": {
      "types": "./dist/label/index.d.ts",
      "import": "./dist/label/index.js"
    },
    "./progress": {
      "types": "./dist/progress/index.d.ts",
      "import": "./dist/progress/index.js"
    },
    "./segmented-control": {
      "types": "./dist/segmented-control/index.d.ts",
      "import": "./dist/segmented-control/index.js"
    },
    "./separator": {
      "types": "./dist/separator/index.d.ts",
      "import": "./dist/separator/index.js"
    },
    "./sheet": {
      "types": "./dist/sheet/index.d.ts",
      "import": "./dist/sheet/index.js"
    },
    "./sheet/behavior": {
      "types": "./dist/sheet/behavior.d.ts",
      "import": "./dist/sheet/behavior.js"
    },
    "./skeleton": {
      "types": "./dist/skeleton/index.d.ts",
      "import": "./dist/skeleton/index.js"
    },
    "./steps": {
      "types": "./dist/steps/index.d.ts",
      "import": "./dist/steps/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "import": "./dist/switch/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "import": "./dist/tabs/index.js"
    },
    "./tabs/behavior": {
      "types": "./dist/tabs/behavior.d.ts",
      "import": "./dist/tabs/behavior.js"
    },
    "./text-link": {
      "types": "./dist/text-link/index.d.ts",
      "import": "./dist/text-link/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@open-components/utils": "workspace:*",
    "class-variance-authority": "catalog:"
  },
  "devDependencies": {
    "jsdom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
