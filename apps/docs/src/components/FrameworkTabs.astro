---
interface Props {
  react: string;
  angular: string;
  web: string;
}

const { react, angular, web } = Astro.props;
const tabs = [
  { id: 'react', label: 'React', code: react },
  { id: 'angular', label: 'Angular', code: angular },
  { id: 'web', label: 'Web Component', code: web },
];
---

<div data-framework-tabs class="overflow-hidden rounded-lg border">
  <div role="tablist" class="flex gap-1 border-b bg-muted/40 p-1">
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          data-tab={tab.id}
          data-active={index === 0 ? 'true' : 'false'}
          aria-selected={index === 0 ? 'true' : 'false'}
          class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors data-[active=true]:bg-background data-[active=true]:text-foreground data-[active=true]:shadow-sm"
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab, index) => (
      <div data-panel={tab.id} hidden={index !== 0}>
        <pre class="overflow-x-auto p-4 text-xs leading-relaxed">
          <code>{tab.code}</code>
        </pre>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-framework-tabs]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((candidate) => {
          const isActive = candidate === button;
          candidate.dataset.active = String(isActive);
          candidate.setAttribute('aria-selected', String(isActive));
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== button.dataset.tab;
        });
      });
    });
  });
</script>
