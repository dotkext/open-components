---
interface Props {
  code: string;
  filename?: string;
}

const { code, filename } = Astro.props;
---

<div class="overflow-hidden rounded-lg border bg-muted/30">
  {
    filename && (
      <div class="border-b px-4 py-2 text-xs font-medium text-muted-foreground">{filename}</div>
    )
  }
  <pre class="overflow-x-auto p-4 text-xs leading-relaxed"><code>{code}</code></pre>
</div>
